# Copier en .env et remplir.
CODE_SECRET_RELEVE=changer-moi
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changer-moi-aussi

# Accès HTTPS depuis l'extérieur (Caddy). Laisser vide pour désactiver.
VERRIERE_PUBLIC_URL=https://biche-verriere.duckdns.org:8443
# Token DuckDNS : en haut de la page https://www.duckdns.org une fois connecté
DUCKDNS_TOKEN=changer-moi-encore
